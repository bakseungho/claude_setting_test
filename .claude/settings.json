{
  "language": "korean",
  "extraKnownMarketplaces": [{ "name": "claude-dev-workflow", "source": "bakseungho/claude_setting_test" }],
  "plugins": {
    "shared-conventions@claude-dev-workflow": true,
    "planning@claude-dev-workflow": true,
    "backend@claude-dev-workflow": true,
    "frontend@claude-dev-workflow": true,
    "design@claude-dev-workflow": true,
    "qa@claude-dev-workflow": true,
    "orchestrator@claude-dev-workflow": true
  },
  "permissions": {
    "allow": ["Read", "Edit", "Write"],
    "deny": ["Read(.env)", "Read(.env.*)", "Read(*.key)", "Read(*.pem)", "Read(credentials.json)"]
  }
}
