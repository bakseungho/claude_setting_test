{
  "language": "korean",
  "permissions": {
    "allow": ["Read", "Edit", "Write"],
    "deny": ["Read(.env)", "Read(.env.*)", "Read(*.key)", "Read(*.pem)", "Read(credentials.json)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-config.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-save.sh"
          }
        ]
      }
    ]
  }
}
